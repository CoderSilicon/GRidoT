root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inl}]
indent_size = 2
max_line_length = 100

[*.{cmake,txt}]
indent_size = 2

[{Makefile,makefile,*.mk}]
indent_style = tab

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.{1,3,5,7,8,roff}]
indent_style = space

[*.bat]
end_of_line = crlf